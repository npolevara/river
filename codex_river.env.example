# Copy this file to codex_river.env. The real file is ignored by Git.
CODEX_RIVER_API_TOKENS=first-local-key,second-local-key
PORT=4005
CODEX_RIVER_BIND_IP=127.0.0.1

# Optional diagnostics. Full app-server logging can contain prompt/response text.
CODEX_RIVER_LOG_LEVEL=info
CODEX_RIVER_LOG_APP_SERVER=false

# Optional Codex app-server overrides.
# CODEX_APP_SERVER_COMMAND=codex
# CODEX_APP_SERVER_CWD=/absolute/path/to/workspace
# CODEX_APP_SERVER_MODEL=gpt-5.6-sol
# CODEX_APP_SERVER_TIMEOUT_MS=120000
# CODEX_APP_SERVER_SANDBOX=read-only
# CODEX_APP_SERVER_APPROVAL_POLICY=never
# LLM_FORCE_LOW=false
